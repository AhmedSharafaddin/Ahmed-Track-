# انسخ هذا الملف إلى itrack.env في مجلد التشغيل وعدّل ما تحتاجه. الأسطر المعلّقة = القيم الافتراضية.
# PORT=8080
# HOST=0.0.0.0
# DATA_DIR=./data
# BACKUP_KEEP=14

# HTTPS (ضروري للميكروفون وتثبيت التطبيق على الجوال) — أو اترك الخادم خلف IIS/Nginx/Caddy وفعّل TRUST_PROXY
# TLS_CERT=/path/fullchain.pem
# TLS_KEY=/path/privkey.pem
# TRUST_PROXY=1

# invite: أول حساب ينشئ الجهة، والبقية برمز دعوة من المسؤول. open: أي أحد ينشئ حسابًا.
# SIGNUP=invite

# الذكاء الاصطناعي (الإدخال الصوتي ومحضر الاجتماع). أي خدمة متوافقة مع OpenAI:
#  سحابية:  AI_URL=https://api.openai.com/v1   AI_KEY=sk-...   AI_STT_MODEL=whisper-1   AI_LLM_MODEL=gpt-4o-mini
#  محلية (لا يخرج الصوت من الشركة): خادم whisper.cpp/faster-whisper + Ollama يعرضان /v1
# AI_URL=
# AI_KEY=
# AI_STT_MODEL=whisper-1
# AI_LLM_MODEL=gpt-4o-mini
